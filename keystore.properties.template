# 릴리스 서명 설정 템플릿.
# 이 파일을 복사해 프로젝트 루트에 keystore.properties 로 저장하고 값을 채우세요.
# keystore.properties 는 .gitignore 로 커밋에서 제외됩니다(비밀 유출 방지).
#
# 업로드 키스토어 생성(1회):
#   keytool -genkeypair -v -keystore petling-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias petling
#
# Google Play App Signing 사용 시, 이 키는 "업로드 키"이며 Google이 앱 서명 키를 별도 관리합니다.
# petling-upload.jks 와 아래 비밀번호는 안전한 곳에 백업하세요(분실 시 업로드 키 재설정 필요).

storeFile=petling-upload.jks
storePassword=CHANGE_ME
keyAlias=petling
keyPassword=CHANGE_ME
