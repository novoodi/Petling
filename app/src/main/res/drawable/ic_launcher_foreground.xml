<?xml version="1.0" encoding="utf-8"?>
<!-- 마트메모 런처 아이콘 전경: 흰 가격표(구멍 뚫린 태그) + ₩ 글리프.
     108x108 뷰포트, 콘텐츠는 안전영역(중앙 지름 66 원) 안에 배치. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:rotation="-18"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 태그 몸체(왼쪽 뾰족 + 오른쪽 라운드) — evenOdd로 끈 구멍 관통 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M42,37 L77,37 Q83,37 83,43 L83,65 Q83,71 77,71 L42,71 L25,54 Z
                M32,54 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />

        <!-- ₩ : W 획 -->
        <path
            android:strokeColor="#DE6A2C"
            android:strokeWidth="3.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M51,46 L55.5,62 L60,49.5 L64.5,62 L69,46" />
        <!-- ₩ : 가로 이중선 -->
        <path
            android:strokeColor="#DE6A2C"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M48.5,51 L71.5,51 M48.5,56.5 L71.5,56.5" />
    </group>
</vector>
