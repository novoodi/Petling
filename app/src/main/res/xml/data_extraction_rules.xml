<?xml version="1.0" encoding="utf-8"?>
<!--
   온디바이스 프라이버시: 캡처/OCR/음성/캐릭터 데이터는 이 기기를 떠나지 않는다.
   백업은 앱 수준에서 꺼져 있다(AndroidManifest: allowBackup="false").
   혹시 재활성화하더라도 로컬 DB는 클라우드 백업/기기 이전에서 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="petling.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="petling.db" />
    </device-transfer>
</data-extraction-rules>
